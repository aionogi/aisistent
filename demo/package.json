{
  "name": "aisistent-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4310",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"tests/unit/**/*.test.ts\" \"tests/db/**/*.test.ts\"",
    "db:migrate": "node scripts/db/migrate.ts",
    "ops:cleanup": "node scripts/operations/cleanup.ts",
    "dev:local-auth": "node scripts/dev/local-auth.ts",
    "dev:auth0": "node scripts/dev/auth0-local.ts",
    "test:e2e": "node --test \"tests/e2e/**/*.test.ts\"",
    "test:recovery": "node --test \"tests/recovery/**/*.test.ts\""
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.32.1",
    "@fontsource-variable/manrope": "^5.2.8",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "17.10.0-beta.17",
    "oauth2-mock-server": "^9.3.0",
    "typescript": "^5.9.0"
  }
}
