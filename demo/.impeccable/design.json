    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared azure landing action with its shipped hover and focus treatments.",
      "html": "<a class=\"ds-primary\" href=\"#demo\">Upoznajte aisistent <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></a>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:16px;font-family:var(--font-sans,\"Manrope Variable\",Manrope,sans-serif);font-size:13px;font-weight:700;border-radius:8px;padding:13px 19px;min-height:44px;border:0;color:#fff;background:var(--blue,#2159e8);text-decoration:none;white-space:nowrap;transition:background .2s,transform .2s}.ds-primary:hover{background:var(--blue-dark,#1749c8);transform:translateY(-2px)}.ds-primary:focus-visible{outline:3px solid #6b91ef;outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
